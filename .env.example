# Uygulama
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
TZ=UTC

# PostgreSQL
DATABASE_URL=postgres://hbb:CHANGE_ME@localhost:5432/salon

# Oturum çerezi
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Yüklenen salon fotoğrafları
UPLOAD_DIR=./server/data/uploads

# NVI kimlik doğrulama. kps-public açık servisi kullanır, anahtar gerekmez.
# Kurumsal KPS adresine geçmek için NVI_ENDPOINT değiştirilir. Testte off.
NVI_MODE=kps-public
NVI_ENDPOINT=https://tckimlik.nvi.gov.tr/Service/KPSPublicV2.asmx
NVI_TIMEOUT_MS=8000
# Ad, soyad ve adres için belediyenin KPS hesabı. Boşsa bu bilgiler gelmez.
NVI_USERNAME=
NVI_PASSWORD=
NVI_STS_URL=https://kimlikdogrulama.nvi.gov.tr/Services/Issuer.svc/IWSTrust13
NVI_KPS_URL=https://kpsv2.nvi.gov.tr/Services/RoutingService.svc

# Üretim Docker (docker-compose.yml)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# APP_ORIGIN üretimde örneğin https://salon.hatay.bel.tr
